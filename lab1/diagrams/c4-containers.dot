digraph CommandX {
graph [rankdir=LR, bgcolor="#f8fafc", pad="0.4", nodesep="0.5", ranksep="0.7", fontname="Arial", label="CommandX · C4 Container", labelloc=t, fontsize=24];
node [shape=box, style="rounded,filled", fontname="Arial", fontsize=12, margin="0.22,0.15", color="#1e40af", fillcolor="#dbeafe"];
edge [fontname="Arial", fontsize=10, color="#64748b"];
user [label="Пользователь\n[Person]\nУправляет своими SSH-серверами", fillcolor="#e2e8f0", color="#475569"];
admin [label="Администратор\n[Person · is_staff]\nУправляет пользователями и подписками", fillcolor="#e2e8f0", color="#475569"];
subgraph cluster_system {
label="Программная система CommandX"; color="#94a3b8"; style="rounded,dashed";
web [label="Web Client\n[Container: React / TypeScript / Vite]\nСерверы, терминал, файлы, мониторинг"];
api [label="Backend API\n[Container: Python / Django REST Framework]\nJWT, права владельца, SSH, AI, профиль"];
db [shape=cylinder, label="Database\n[Container: SQLite local / PostgreSQL deployment]\nПользователи, серверы, метрики, транзакции"];
media [shape=folder, label="Media storage\n[Container: filesystem]\nЗагруженные аватары"];
}
ssh [label="Собственный сервер пользователя\n[External system: Linux / SSH]\nКоманды и файлы с правами SSH-аккаунта", fillcolor="#f1f5f9", color="#64748b"];
ai [label="AI provider\n[External system · optional]\nОтветы помощника", fillcolor="#f1f5f9", color="#64748b"];
user -> web [label="Использует браузер"];
admin -> web [label="Использует браузер"];
web -> api [label="HTTPS / JSON, Bearer JWT\nHTTP loopback при разработке"];
api -> db [label="Django ORM / SQL"];
api -> media [label="Сохраняет и читает аватары"];
api -> ssh [label="SSH / Paramiko\nПроверенный host key"];
api -> ai [label="HTTPS / текстовый контекст"];
}
