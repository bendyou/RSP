digraph ERD {
graph [rankdir=LR, bgcolor="white", pad="0.35", nodesep="0.45", ranksep="1.1", splines=spline, label="ERD · Интеллектуальная панель управления серверами\nPK — первичный ключ; FK — внешний ключ; UK — уникальное поле; ? — допускается NULL\nСвязь: родитель 1 (или 0..1) → дочерние записи 0..N", labelloc=t, fontsize=20, fontname="Arial"];
node [shape=plain, fontname="Arial"];
edge [color="#64748b", fontname="Arial", fontsize=10, dir=both, arrowsize=0.7];
roles [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#123b62" COLSPAN="2"><FONT COLOR="white"><B>roles</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">PK id</TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="LEFT" PORT="code">UK code</TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT" PORT="name">name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR></TABLE>>];
users [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#123b62" COLSPAN="2"><FONT COLOR="white"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">PK id</TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="LEFT" PORT="role_id">FK role_id</TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="LEFT" PORT="email">UK email</TD><TD ALIGN="LEFT">VARCHAR(254)</TD></TR><TR><TD ALIGN="LEFT" PORT="password_hash">password_hash</TD><TD ALIGN="LEFT">TEXT</TD></TR><TR><TD ALIGN="LEFT" PORT="full_name">full_name</TD><TD ALIGN="LEFT">VARCHAR(150)</TD></TR><TR><TD ALIGN="LEFT" PORT="is_active">is_active</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR></TABLE>>];
servers [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#123b62" COLSPAN="2"><FONT COLOR="white"><B>servers</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">PK id</TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="LEFT" PORT="name">UK name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT" PORT="hostname">UK hostname</TD><TD ALIGN="LEFT">VARCHAR(253)</TD></TR><TR><TD ALIGN="LEFT" PORT="agent_identity">UK agent_identity</TD><TD ALIGN="LEFT">VARCHAR(200)</TD></TR><TR><TD ALIGN="LEFT" PORT="is_active">is_active</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR><TR><TD ALIGN="LEFT" PORT="last_seen_at">last_seen_at ?</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR></TABLE>>];
metric_types [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#123b62" COLSPAN="2"><FONT COLOR="white"><B>metric_types</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">PK id</TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="LEFT" PORT="code">UK code</TD><TD ALIGN="LEFT">VARCHAR(50)</TD></TR><TR><TD ALIGN="LEFT" PORT="name">name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT" PORT="unit">unit</TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR></TABLE>>];
metric_samples [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#123b62" COLSPAN="2"><FONT COLOR="white"><B>metric_samples</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">PK id</TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="LEFT" PORT="server_id">FK server_id</TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="LEFT" PORT="metric_type_id">FK metric_type_id</TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="LEFT" PORT="collected_at">collected_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR><TR><TD ALIGN="LEFT" PORT="value">value</TD><TD ALIGN="LEFT">NUMERIC(14,4)</TD></TR></TABLE>>];
alert_rules [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#123b62" COLSPAN="2"><FONT COLOR="white"><B>alert_rules</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">PK id</TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="LEFT" PORT="server_id">FK server_id</TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="LEFT" PORT="metric_type_id">FK metric_type_id</TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="LEFT" PORT="name">name</TD><TD ALIGN="LEFT">VARCHAR(150)</TD></TR><TR><TD ALIGN="LEFT" PORT="threshold">threshold</TD><TD ALIGN="LEFT">NUMERIC(14,4)</TD></TR><TR><TD ALIGN="LEFT" PORT="duration_seconds">duration_seconds</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT" PORT="severity">severity</TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR><TR><TD ALIGN="LEFT" PORT="is_enabled">is_enabled</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR></TABLE>>];
alerts [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#123b62" COLSPAN="2"><FONT COLOR="white"><B>alerts</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">PK id</TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="LEFT" PORT="rule_id">FK rule_id</TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="LEFT" PORT="opened_at">opened_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR><TR><TD ALIGN="LEFT" PORT="acknowledged_by">FK acknowledged_by ?</TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="LEFT" PORT="acknowledged_at">acknowledged_at ?</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR><TR><TD ALIGN="LEFT" PORT="resolved_at">resolved_at ?</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR></TABLE>>];
recommendations [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#123b62" COLSPAN="2"><FONT COLOR="white"><B>recommendations</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">PK id</TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="LEFT" PORT="server_id">FK server_id</TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="LEFT" PORT="metric_type_id">FK metric_type_id</TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="LEFT" PORT="algorithm_version">algorithm_version</TD><TD ALIGN="LEFT">VARCHAR(50)</TD></TR><TR><TD ALIGN="LEFT" PORT="window_start">window_start</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR><TR><TD ALIGN="LEFT" PORT="window_end">window_end</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR><TR><TD ALIGN="LEFT" PORT="anomaly_score">anomaly_score</TD><TD ALIGN="LEFT">NUMERIC(12,4)</TD></TR><TR><TD ALIGN="LEFT" PORT="explanation">explanation</TD><TD ALIGN="LEFT">TEXT</TD></TR><TR><TD ALIGN="LEFT" PORT="suggested_action">suggested_action</TD><TD ALIGN="LEFT">TEXT</TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="LEFT">VARCHAR(12)</TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR></TABLE>>];
operations [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#123b62" COLSPAN="2"><FONT COLOR="white"><B>operations</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">PK id</TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="LEFT" PORT="server_id">FK server_id</TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="LEFT" PORT="requested_by">FK requested_by</TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="LEFT" PORT="kind">kind</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="LEFT" PORT="service_name">service_name ?</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="LEFT">VARCHAR(12)</TD></TR><TR><TD ALIGN="LEFT" PORT="requested_at">requested_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR><TR><TD ALIGN="LEFT" PORT="started_at">started_at ?</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR><TR><TD ALIGN="LEFT" PORT="finished_at">finished_at ?</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR><TR><TD ALIGN="LEFT" PORT="result_summary">result_summary ?</TD><TD ALIGN="LEFT">TEXT</TD></TR></TABLE>>];
audit_events [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#123b62" COLSPAN="2"><FONT COLOR="white"><B>audit_events</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">PK id</TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="LEFT" PORT="actor_id">FK actor_id ?</TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="LEFT" PORT="event_type">event_type</TD><TD ALIGN="LEFT">VARCHAR(80)</TD></TR><TR><TD ALIGN="LEFT" PORT="description">description</TD><TD ALIGN="LEFT">TEXT</TD></TR><TR><TD ALIGN="LEFT" PORT="occurred_at">occurred_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR></TABLE>>];
roles:e -> users:role_id:w [arrowtail=teetee, arrowhead=odotcrow, tooltip="roles 1 — 0..N users (role_id)"];
servers:e -> metric_samples:server_id:w [arrowtail=teetee, arrowhead=odotcrow, tooltip="servers 1 — 0..N metric_samples (server_id)"];
metric_types:e -> metric_samples:metric_type_id:w [arrowtail=teetee, arrowhead=odotcrow, tooltip="metric_types 1 — 0..N metric_samples (metric_type_id)"];
servers:e -> alert_rules:server_id:w [arrowtail=teetee, arrowhead=odotcrow, tooltip="servers 1 — 0..N alert_rules (server_id)"];
metric_types:e -> alert_rules:metric_type_id:w [arrowtail=teetee, arrowhead=odotcrow, tooltip="metric_types 1 — 0..N alert_rules (metric_type_id)"];
alert_rules:e -> alerts:rule_id:w [arrowtail=teetee, arrowhead=odotcrow, tooltip="alert_rules 1 — 0..N alerts (rule_id)"];
users:e -> alerts:acknowledged_by:w [arrowtail=odottee, arrowhead=odotcrow, tooltip="users 0..1 — 0..N alerts (acknowledged_by)"];
servers:e -> recommendations:server_id:w [arrowtail=teetee, arrowhead=odotcrow, tooltip="servers 1 — 0..N recommendations (server_id)"];
metric_types:e -> recommendations:metric_type_id:w [arrowtail=teetee, arrowhead=odotcrow, tooltip="metric_types 1 — 0..N recommendations (metric_type_id)"];
servers:e -> operations:server_id:w [arrowtail=teetee, arrowhead=odotcrow, tooltip="servers 1 — 0..N operations (server_id)"];
users:e -> operations:requested_by:w [arrowtail=teetee, arrowhead=odotcrow, tooltip="users 1 — 0..N operations (requested_by)"];
users:e -> audit_events:actor_id:w [arrowtail=odottee, arrowhead=odotcrow, tooltip="users 0..1 — 0..N audit_events (actor_id)"];
}