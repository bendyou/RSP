digraph ERD {
graph [rankdir=LR, bgcolor="#f8fafc", pad="0.3", nodesep="0.3", ranksep="0.8", fontname="Arial", label="CommandX · ERD · физическая модель", labelloc=t, fontsize=22];
node [shape=plain, fontname="Arial"];
edge [fontname="Arial", fontsize=10, color="#64748b"];
auth_user [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#1e3a8a"><FONT COLOR="white"><B>auth_user</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id PK</TD><TD PORT="pk" ALIGN="LEFT">integer NN</TD></TR><TR><TD PORT="password" ALIGN="LEFT">password</TD><TD ALIGN="LEFT">varchar(128) NN</TD></TR><TR><TD PORT="last_login" ALIGN="LEFT">last_login</TD><TD ALIGN="LEFT">timestamp with time zone NULL</TD></TR><TR><TD PORT="is_superuser" ALIGN="LEFT">is_superuser</TD><TD ALIGN="LEFT">boolean NN</TD></TR><TR><TD PORT="username" ALIGN="LEFT">username UQ</TD><TD ALIGN="LEFT">varchar(150) NN</TD></TR><TR><TD PORT="first_name" ALIGN="LEFT">first_name</TD><TD ALIGN="LEFT">varchar(150) NN</TD></TR><TR><TD PORT="last_name" ALIGN="LEFT">last_name</TD><TD ALIGN="LEFT">varchar(150) NN</TD></TR><TR><TD PORT="email" ALIGN="LEFT">email</TD><TD ALIGN="LEFT">varchar(254) NN</TD></TR><TR><TD PORT="is_staff" ALIGN="LEFT">is_staff</TD><TD ALIGN="LEFT">boolean NN</TD></TR><TR><TD PORT="is_active" ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">boolean NN</TD></TR><TR><TD PORT="date_joined" ALIGN="LEFT">date_joined</TD><TD ALIGN="LEFT">timestamp with time zone NN</TD></TR></TABLE>>];
api_userprofile [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#1e3a8a"><FONT COLOR="white"><B>api_userprofile</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id PK</TD><TD PORT="pk" ALIGN="LEFT">bigint NN</TD></TR><TR><TD PORT="user_id" ALIGN="LEFT">user_id FK UQ</TD><TD ALIGN="LEFT">integer NN</TD></TR><TR><TD PORT="avatar" ALIGN="LEFT">avatar</TD><TD ALIGN="LEFT">varchar(100) NULL</TD></TR><TR><TD PORT="email_verified" ALIGN="LEFT">email_verified</TD><TD ALIGN="LEFT">boolean NN</TD></TR><TR><TD PORT="email_verification_token" ALIGN="LEFT">email_verification_token</TD><TD ALIGN="LEFT">varchar(100) NULL</TD></TR><TR><TD PORT="balance" ALIGN="LEFT">balance</TD><TD ALIGN="LEFT">numeric(10, 2) NN</TD></TR><TR><TD PORT="subscription_type" ALIGN="LEFT">subscription_type</TD><TD ALIGN="LEFT">varchar(20) NN</TD></TR><TR><TD PORT="subscription_expires_at" ALIGN="LEFT">subscription_expires_at</TD><TD ALIGN="LEFT">timestamp with time zone NULL</TD></TR><TR><TD PORT="created_at" ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamp with time zone NN</TD></TR><TR><TD PORT="updated_at" ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">timestamp with time zone NN</TD></TR></TABLE>>];
api_server [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#1e3a8a"><FONT COLOR="white"><B>api_server</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id PK</TD><TD PORT="pk" ALIGN="LEFT">bigint NN</TD></TR><TR><TD PORT="name" ALIGN="LEFT">name</TD><TD ALIGN="LEFT">varchar(120) NN</TD></TR><TR><TD PORT="host" ALIGN="LEFT">host</TD><TD ALIGN="LEFT">varchar(255) NN</TD></TR><TR><TD PORT="port" ALIGN="LEFT">port</TD><TD ALIGN="LEFT">integer NN</TD></TR><TR><TD PORT="username" ALIGN="LEFT">username</TD><TD ALIGN="LEFT">varchar(120) NN</TD></TR><TR><TD PORT="auth_type" ALIGN="LEFT">auth_type</TD><TD ALIGN="LEFT">varchar(20) NN</TD></TR><TR><TD PORT="password" ALIGN="LEFT">password</TD><TD ALIGN="LEFT">varchar(255) NN</TD></TR><TR><TD PORT="private_key" ALIGN="LEFT">private_key</TD><TD ALIGN="LEFT">text NN</TD></TR><TR><TD PORT="passphrase" ALIGN="LEFT">passphrase</TD><TD ALIGN="LEFT">varchar(255) NN</TD></TR><TR><TD PORT="created_by_id" ALIGN="LEFT">created_by_id FK</TD><TD ALIGN="LEFT">integer NULL</TD></TR><TR><TD PORT="is_active" ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">boolean NN</TD></TR><TR><TD PORT="created_at" ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamp with time zone NN</TD></TR><TR><TD PORT="updated_at" ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">timestamp with time zone NN</TD></TR></TABLE>>];
api_transaction [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#1e3a8a"><FONT COLOR="white"><B>api_transaction</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id PK</TD><TD PORT="pk" ALIGN="LEFT">bigint NN</TD></TR><TR><TD PORT="user_id" ALIGN="LEFT">user_id FK</TD><TD ALIGN="LEFT">integer NN</TD></TR><TR><TD PORT="transaction_type" ALIGN="LEFT">transaction_type</TD><TD ALIGN="LEFT">varchar(20) NN</TD></TR><TR><TD PORT="amount" ALIGN="LEFT">amount</TD><TD ALIGN="LEFT">numeric(10, 2) NN</TD></TR><TR><TD PORT="description" ALIGN="LEFT">description</TD><TD ALIGN="LEFT">text NN</TD></TR><TR><TD PORT="created_at" ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamp with time zone NN</TD></TR></TABLE>>];
api_allocatedserver [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#1e3a8a"><FONT COLOR="white"><B>api_allocatedserver · legacy</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id PK</TD><TD PORT="pk" ALIGN="LEFT">bigint NN</TD></TR><TR><TD PORT="user_id" ALIGN="LEFT">user_id FK</TD><TD ALIGN="LEFT">integer NN</TD></TR><TR><TD PORT="name" ALIGN="LEFT">name</TD><TD ALIGN="LEFT">varchar(120) NN</TD></TR><TR><TD PORT="host" ALIGN="LEFT">host</TD><TD ALIGN="LEFT">varchar(255) NN</TD></TR><TR><TD PORT="port" ALIGN="LEFT">port</TD><TD ALIGN="LEFT">integer NN</TD></TR><TR><TD PORT="username" ALIGN="LEFT">username</TD><TD ALIGN="LEFT">varchar(120) NN</TD></TR><TR><TD PORT="password" ALIGN="LEFT">password</TD><TD ALIGN="LEFT">varchar(255) NN</TD></TR><TR><TD PORT="cpu_cores" ALIGN="LEFT">cpu_cores</TD><TD ALIGN="LEFT">integer NN</TD></TR><TR><TD PORT="memory_gb" ALIGN="LEFT">memory_gb</TD><TD ALIGN="LEFT">integer NN</TD></TR><TR><TD PORT="disk_gb" ALIGN="LEFT">disk_gb</TD><TD ALIGN="LEFT">integer NN</TD></TR><TR><TD PORT="is_active" ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">boolean NN</TD></TR><TR><TD PORT="created_at" ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamp with time zone NN</TD></TR><TR><TD PORT="expires_at" ALIGN="LEFT">expires_at</TD><TD ALIGN="LEFT">timestamp with time zone NULL</TD></TR></TABLE>>];
api_servermetric [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#1e3a8a"><FONT COLOR="white"><B>api_servermetric</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id PK</TD><TD PORT="pk" ALIGN="LEFT">bigint NN</TD></TR><TR><TD PORT="server_id" ALIGN="LEFT">server_id FK</TD><TD ALIGN="LEFT">bigint NULL</TD></TR><TR><TD PORT="allocated_server_id" ALIGN="LEFT">allocated_server_id FK</TD><TD ALIGN="LEFT">bigint NULL</TD></TR><TR><TD PORT="cpu_percent" ALIGN="LEFT">cpu_percent</TD><TD ALIGN="LEFT">double precision NULL</TD></TR><TR><TD PORT="memory_percent" ALIGN="LEFT">memory_percent</TD><TD ALIGN="LEFT">double precision NULL</TD></TR><TR><TD PORT="memory_used_mb" ALIGN="LEFT">memory_used_mb</TD><TD ALIGN="LEFT">double precision NULL</TD></TR><TR><TD PORT="memory_total_mb" ALIGN="LEFT">memory_total_mb</TD><TD ALIGN="LEFT">double precision NULL</TD></TR><TR><TD PORT="disk_percent" ALIGN="LEFT">disk_percent</TD><TD ALIGN="LEFT">double precision NULL</TD></TR><TR><TD PORT="disk_used_gb" ALIGN="LEFT">disk_used_gb</TD><TD ALIGN="LEFT">double precision NULL</TD></TR><TR><TD PORT="disk_total_gb" ALIGN="LEFT">disk_total_gb</TD><TD ALIGN="LEFT">double precision NULL</TD></TR><TR><TD PORT="network_in_mb" ALIGN="LEFT">network_in_mb</TD><TD ALIGN="LEFT">double precision NULL</TD></TR><TR><TD PORT="network_out_mb" ALIGN="LEFT">network_out_mb</TD><TD ALIGN="LEFT">double precision NULL</TD></TR><TR><TD PORT="created_at" ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamp with time zone NN</TD></TR></TABLE>>];
auth_user:pk:e -> api_userprofile:user_id:w [dir=both, arrowtail=none, arrowhead=none, label="1 → 0..1 · CASCADE (ORM)"];
auth_user:pk:e -> api_server:created_by_id:w [dir=both, arrowtail=none, arrowhead=none, label="0..1 → 0..N · SET_NULL (ORM)"];
